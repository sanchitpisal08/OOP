#include<iostream>
using namespace std;

template<typename T>

void mySwap(T &a,T &b)
{
    T temp=a;
    a=b;
    b=temp;
}

int main()
{
    cout<<"Employee IDs : ";
    int emp1=101,emp2=102;
    mySwap(emp1,emp2);
    cout<<emp1<<" "<<emp2<<endl;

    cout<<"Room Numbers : ";
    int room1=201,room2=205;
    mySwap(room1,room2);
    cout<<room1<<" "<<room2<<endl;

    cout<<"Task Priorities : ";
    float p1=1.5,p2=2.5;
    mySwap(p1,p2);
    cout<<p1<<" "<<p2<<endl;

    return 0;
}
