#include<iostream>
#include<string>
using namespace std;
class book
{
private:
int bookID;
string title;
string author;
double price;

public:

book()
{

bookID=101;
title="C++programing";
author="bjarne stroustrup";
price=500.00;
}

book(int id,string t,string a,double p)
{
