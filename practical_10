#include<iostream>
using namespace std;

template<typename T>

void myMax(T a,T b)
{
    cout<<((a>b) ? a:b)<<endl;
}
int main()
{
    cout<<"Maximum marks : ";
    myMax(75,90);

    cout<<"Maximum price : ";
    myMax(3.3,6.6);

    cout<<"maximum Sensor : ";
    myMax(225.5,30.8);

    return 0;
}
